*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
docs/images/*.gif filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text

# Web assets ship in source tarballs (sp-update, release), which never resolve LFS pointers.
public/** !filter !diff !merge binary

# Hand-authored household UI must retain readable reviews and three-way merges.
public/household/*.html text diff merge
public/household/*.js text diff merge
public/household/*.css text diff merge
