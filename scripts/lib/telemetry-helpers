# shellcheck shell=bash
# Stop the stock firmware from reaching Eight Sleep, whatever the iptables
# state. Shared by install and sp-update, which run it on every install and
# update before opening WAN. Idempotent and best-effort: nothing here fails
# the caller.
#
# vector ships the whole journal (sleepypod's logs included) to a Kinesis
# stream in us-east-1 and queues failed sends in up to 256 MB at
# /persistent/vector; telegraf ships metrics. Neither is needed to run the
# pod. Never touch frankenfirmware, dac, Capybara or swupdate here: frank
# drives the hardware.
STOCK_TELEMETRY_UNITS=(vector.service telegraf.service)
VECTOR_DATA_DIR="${VECTOR_DATA_DIR:-/persistent/vector}"

disable_stock_telemetry() {
  local unit state
  for unit in "${STOCK_TELEMETRY_UNITS[@]}"; do
    state=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    case "$state" in
      ''|not-found) ;;
      masked|masked-runtime)
        # Masked by hand without a stop: it keeps running until reboot.
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
          systemctl stop "$unit" 2>/dev/null || true
        fi
        ;;
      *)
        echo "Disabling and masking stock telemetry service $unit..."
        systemctl disable --now "$unit" 2>/dev/null || true
        systemctl mask "$unit" 2>/dev/null || echo "Warning: could not mask $unit" >&2
        ;;
    esac
  done

  # Drop vector's queued journal once it can no longer write there.
  state=$(systemctl is-enabled vector.service 2>/dev/null || true)
  case "$state" in
    ''|not-found|masked|masked-runtime)
      if [ -d "$VECTOR_DATA_DIR" ] && [ -n "$(ls -A "$VECTOR_DATA_DIR" 2>/dev/null)" ]; then
        echo "Clearing vector's disk buffer at $VECTOR_DATA_DIR..."
        find "$VECTOR_DATA_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
      fi
      ;;
  esac
}

# Removes the old /etc/hosts block: its 0.0.0.0 entries send frank to the pod
# itself, where it retries every few ms and fills syslog. Names are blocked
# only by the dnsmasq NXDOMAIN layer (apply_dns_blackhole).
# $1: source tree root holding scripts/internet-control.
apply_name_blocking() {
  local control="$1/scripts/internet-control"
  [ -f "$control" ] || return 0
  bash "$control" hosts-unblock || echo "Warning: could not remove the old /etc/hosts telemetry block (continuing)" >&2
}

# Runs before WAN opens, so frank can't reach Eight Sleep while it is open:
# remove the hosts block, then turn on the dnsmasq NXDOMAIN layer.
block_stock_telemetry() {
  disable_stock_telemetry
  apply_name_blocking "$1"
  apply_dns_blackhole "$1"
}

# The standalone dnsmasq never touches NetworkManager, so swapping
# /etc/resolv.conf is safe before downloads; callers also run it after them so
# a new tree's config is applied (a no-op when unchanged). Never fails: a DNS
# problem must not abort an install or update, and dns-block rolls itself back.
# $1: source tree root holding scripts/internet-control.
apply_dns_blackhole() {
  local control="$1/scripts/internet-control"
  [ -f "$control" ] || return 0
  bash "$control" dns-block || echo "Warning: dnsmasq NXDOMAIN block not applied; no Eight Sleep name blocking (continuing)" >&2
  return 0
}
