# Install on both fresh and OTA updates; no changes to sleepypod.service needed
# for old installations, whose default sp-maintenance invocation is now cheap.
install_maintenance_timer() {
  local unit
  for unit in sleepypod-maintenance.service sleepypod-maintenance.timer; do
    install -m 0644 "$INSTALL_DIR/scripts/systemd/$unit" "/etc/systemd/system/$unit"
  done
  systemctl daemon-reload
  systemctl enable --now sleepypod-maintenance.timer
  reconcile_stock_telemetry
  reconcile_internet_choice_restore
}

# Same first-update problem for the root ExecStartPre that re-applies a block
# saved in Settings at boot (scripts/lib/internet-choice-helpers): older
# updaters don't write its drop-in or the root-owned sp-internet-control.
# Idempotent; runs in a subshell so it can't abort the caller's update.
reconcile_internet_choice_restore() {
  [ -f "$INSTALL_DIR/scripts/lib/internet-choice-helpers" ] || return 0
  (
    source "$INSTALL_DIR/scripts/lib/internet-choice-helpers"
    install_internet_choice_restore "$INSTALL_DIR"
  ) || echo "Warning: saved internet access restore setup failed (continuing)" >&2
  return 0
}

# Updaters from before scripts/lib/telemetry-helpers (v3.5.0 and older) source
# this file from the new tree after every download but never call the
# telemetry blocking, so without this a pod needed a second update to get it.
# Idempotent, so newer updaters that also call it directly are unaffected.
# Runs in a subshell: nothing here may abort the caller's update.
reconcile_stock_telemetry() {
  [ -f "$INSTALL_DIR/scripts/lib/telemetry-helpers" ] || return 0
  (
    source "$INSTALL_DIR/scripts/lib/telemetry-helpers"
    block_stock_telemetry "$INSTALL_DIR"
    apply_dns_blackhole "$INSTALL_DIR"
  ) || echo "Warning: Eight Sleep telemetry blocking failed (continuing)" >&2
  return 0
}
