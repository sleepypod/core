#!/bin/bash
# Variables below are consumed by scripts that source this file.
# shellcheck disable=SC2034
# DAC socket discovery; filesystem layout does not identify hub or cover hardware.
# Sourced by scripts/install and CLI tools. No DAC commands are sent.
# Sets INSTALL_DIR, DATA_DIR, DAC_SOCK_PATH, DAC_SOCK_SOURCE and POD_GEN.
# POD_GEN is retained for compatibility, always "unknown" until reliable,
# independent hardware identification is available.

INSTALL_DIR="${INSTALL_DIR:-/home/dac/sleepypod-core}"
# DATA_DIR pointer is written by scripts/install (storage-aware picker:
# /persistent vs rootfs by total partition size). Env override > pointer
# file > legacy /persistent default for installs that pre-date the pointer.
if [ -z "${DATA_DIR:-}" ] && [ -r /etc/sleepypod/data-dir ] && [ -s /etc/sleepypod/data-dir ]; then
  DATA_DIR="$(cat /etc/sleepypod/data-dir)"
fi
DATA_DIR="${DATA_DIR:-/persistent/sleepypod-data}"

# Only accept known firmware-supported socket locations
is_supported_dac_path() {
  case "$1" in
    /deviceinfo/dac.sock|/persistent/deviceinfo/dac.sock) return 0 ;;
    *) return 1 ;;
  esac
}

detect_dac_sock() {
  local path="" sock

  # Priority 1: Read from existing .env, but cross-check the value against
  # socket availability. A previous install can cache an allowed path that
  # is wrong for the current firmware layout, and
  # the cache stays sticky until .env is deleted. Only honor the cache if
  # a socket file exists OR frank.sh confirms it.
  if [ -f "$INSTALL_DIR/.env" ]; then
    path=$(grep '^DAC_SOCK_PATH=' "$INSTALL_DIR/.env" 2>/dev/null | cut -d= -f2- || true)
    if [ -n "$path" ] && is_supported_dac_path "$path"; then
      local verified=false
      # (a) Socket file exists (not a connection/health check)
      [ -S "$path" ] && verified=true
      # (b) frank.sh agrees with .env → authoritative
      if [ "$verified" = false ] && [ -f /opt/eight/bin/frank.sh ]; then
        local frank_path
        frank_path=$(grep -oE 'DAC_SOCKET=[^ ]*dac\.sock' /opt/eight/bin/frank.sh 2>/dev/null \
          | head -1 | cut -d= -f2- || true)
        [ -n "$frank_path" ] && [ "$frank_path" = "$path" ] && verified=true
      fi
      if [ "$verified" = true ]; then
        DAC_SOCK_PATH="$path"
        DAC_SOCK_SOURCE="configuration (socket or firmware confirmed)"
        return
      fi
      echo "Warning: Ignoring stale DAC_SOCK_PATH from .env ($path); re-discovering socket location" >&2
    elif [ -n "$path" ]; then
      echo "Warning: Ignoring unsupported DAC_SOCK_PATH from .env: $path" >&2
    fi
  fi

  # Priority 2: Extract from frank.sh (what frankenfirmware actually uses)
  if [ -f /opt/eight/bin/frank.sh ]; then
    # grep -o '[^ ]*dac\.sock' is greedy against the left; on a line like
    # `DAC_SOCKET=/deviceinfo/dac.sock` (no spaces), it matches the whole
    # string including `DAC_SOCKET=`. Anchor the capture to the prefix and
    # strip it so we get just the path, independent of hardware generation.
    path=$(grep -oE 'DAC_SOCKET=[^ ]*dac\.sock' /opt/eight/bin/frank.sh 2>/dev/null \
      | head -1 | cut -d= -f2- || true)
    if [ -n "$path" ] && is_supported_dac_path "$path"; then
      echo "Detected dac.sock path from frank.sh: $path" >&2
      DAC_SOCK_PATH="$path"
      DAC_SOCK_SOURCE="firmware (frank.sh)"
      return
    elif [ -n "$path" ]; then
      echo "Warning: Ignoring unsupported DAC_SOCK_PATH from frank.sh: $path" >&2
    fi
  fi

  # Priority 3: Check known socket locations
  for sock in /persistent/deviceinfo/dac.sock /deviceinfo/dac.sock; do
    if [ -S "$sock" ]; then
      echo "Found dac.sock socket file at: $sock" >&2
      DAC_SOCK_PATH="$sock"
      DAC_SOCK_SOURCE="existing socket file"
      return
    fi
  done

  # Priority 4: Keep the historical fresh-install fallback. Neither its
  # existence nor firmware use is verified; it may need correction.
  DAC_SOCK_PATH="/persistent/deviceinfo/dac.sock"
  DAC_SOCK_SOURCE="fallback (unverified)"
  echo "Warning: No usable DAC socket configuration, firmware path, or socket file found; using unverified fallback: $DAC_SOCK_PATH. If firmware expects another path, DAC communication will fail." >&2
}

detect_dac_sock
POD_GEN="unknown"
