#!/bin/bash
set -euo pipefail

# sp-maintenance — essential boot repairs; deferred housekeeping with --housekeeping
#
# Called by sleepypod.service ExecStartPre so it runs before the app starts.
# Expensive cleanup runs independently from sleepypod-maintenance.timer.

# DATA_DIR pointer is written by scripts/install (storage-aware picker).
# Legacy fallback keeps installs without the pointer file working.
if [ -r /etc/sleepypod/data-dir ] && [ -s /etc/sleepypod/data-dir ]; then
  DATA_DIR="$(cat /etc/sleepypod/data-dir)"
else
  DATA_DIR="/persistent/sleepypod-data"
fi
INSTALL_DIR="/home/dac/sleepypod-core"

echo "=== SleepyPod Maintenance ==="

case "${1:-}" in
  --housekeeping)
    # 1. Vacuum systemd journal (cap at 50MB)
    if command -v journalctl &>/dev/null; then
      # Guard against two failure modes reported on a fresh Pod 4:
      # (a) /persistent/journal missing → `du` fails, pipefail propagates, the
      #     whole $(…) subshell errors under `set -e` unless we tolerate it.
      # (b) directory exists but awk output is empty → `[ "" -gt 50 ]` errors
      #     with "integer expression expected" under `set -e`.
      # Belt-and-suspenders: tolerate pipeline failure with `|| true`, then
      # default the variable to 0 if still unset/empty.
      JOURNAL_SIZE=$(du -sm /persistent/journal 2>/dev/null | awk '{print $1}' || true)
      JOURNAL_SIZE=${JOURNAL_SIZE:-0}
      if [ "$JOURNAL_SIZE" -gt 50 ]; then
        echo "Vacuuming journal (${JOURNAL_SIZE}MB → 50MB)..."
        journalctl --vacuum-size=50M 2>/dev/null || true
      fi
    fi

    # 2. Clean stale temp files (leftover from failed updates, builds, etc.)
    TEMP_CLEANED=0
    for d in /tmp/tmp.* /tmp/sleepypod-* /tmp/sp-* /tmp/core-*; do
      # Never remove fresh update/build staging directories while the app is live.
      if [ -e "$d" ] \
        && RECENT_ACTIVITY=$(find "$d" -mtime -2 -print -quit 2>/dev/null) \
        && [ -z "$RECENT_ACTIVITY" ]; then
        rm -rf "$d" 2>/dev/null && TEMP_CLEANED=$((TEMP_CLEANED + 1))
      fi
    done
    [ "$TEMP_CLEANED" -gt 0 ] && echo "Cleaned $TEMP_CLEANED stale temp entries."

    # 3. Prune old database backups (keep 3 most recent of each kind).
    # Each backup set is a triplet — sleepypod.db.bak.<ts>, plus the matching
    # sleepypod.db-wal.bak.<ts> and sleepypod.db-shm.bak.<ts> sidecars created
    # by sp-update. Pruning only the .db files would leak WAL/SHM backups for
    # pruned timestamps.
    if [ -d "$DATA_DIR" ]; then
      prune_bak_pattern() {
        local pattern="$1"
        # `ls $DIR/glob | wc -l` dies under set -euo pipefail when the glob
        # doesn't match (ls exits 1 on "no such file", pipefail propagates,
        # set -e kills the command substitution). Use `find` instead: clean
        # exit 0 whether or not matches exist.
        local count
        count=$(find "$DATA_DIR" -maxdepth 1 -name "$pattern" -type f 2>/dev/null | wc -l)
        count=${count:-0}
        if [ "$count" -gt 3 ]; then
          local prune=$((count - 3))
          find "$DATA_DIR" -maxdepth 1 -name "$pattern" -type f -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn | tail -n "$prune" | awk '{print $2}' | xargs -r rm -f
          echo "Pruned $prune old $pattern backups (kept 3)."
        fi
      }
      prune_bak_pattern 'sleepypod.db.bak.*'
      prune_bak_pattern 'sleepypod.db-wal.bak.*'
      prune_bak_pattern 'sleepypod.db-shm.bak.*'
    fi

    # 4. Prune pnpm content-addressable store
    if command -v pnpm &>/dev/null; then
      STORE_SIZE=$(du -sm /home/root/.local/share/pnpm/store 2>/dev/null | awk '{print $1}' || true)
      STORE_SIZE=${STORE_SIZE:-0}
      if [ "$STORE_SIZE" -gt 100 ]; then
        echo "Pruning pnpm store (${STORE_SIZE}MB)..."
        pnpm store prune 2>/dev/null || true
      fi
    fi

    echo "Housekeeping complete."
    exit 0
    ;;
  ''|--startup) ;;
  *) echo "Usage: sp-maintenance [--startup|--housekeeping]" >&2; exit 2 ;;
esac

# Stock firmware guard. Updaters v2.0–v2.8 never call install_maintenance_timer
# and run their own tree's `internet-control hosts-block`, which writes the
# 0.0.0.0 block that sends frank into a retry storm against the pod itself.
# Every version since v2.0 copies the new tree's scripts/bin/sp-* into
# /usr/local/bin and runs this as root before every start, so these repairs
# reach any pod on its first start after an update.
# Self-contained on purpose: this runs as root, so it never sources anything
# from $INSTALL_DIR (the service user can write there). DNS and dnsmasq stay
# in the update paths. Best-effort and fast: a no-op when there is nothing to
# do, and nothing here fails sp-maintenance or waits on a unit stopping.
# SLEEPYPOD_ROOT prefixes every path for script tests; on a pod it is empty.
STOCK_ROOT="${SLEEPYPOD_ROOT:-}"
STOCK_HOSTS_FILE="$STOCK_ROOT/etc/hosts"
STOCK_HOSTS_BEGIN="# BEGIN sleepypod-telemetry-block"
STOCK_HOSTS_END="# END sleepypod-telemetry-block"
# Keep in sync with scripts/lib/telemetry-helpers (a test checks).
STOCK_TELEMETRY_UNITS=(vector.service telegraf.service)
STOCK_APP_UNITS=(dac.service)
STOCK_FIRMWARE_UPDATE_UNITS=(swupdate.socket swupdate.service swupdate-progress.service defibrillator.service)
STOCK_KERNEL_UNITS=(eight-kernel.service)
FIRMWARE_UPDATES_CHOICE="$STOCK_ROOT/etc/sleepypod/firmware-updates"

# Same result as internet-control's remove_hosts_block: backup, then drop the
# managed block and its trailing blank lines; refuse on malformed markers.
remove_stock_hosts_block() {
  local begin_count end_count begin_line end_line tmp
  grep -Fq "sleepypod-telemetry-block" "$STOCK_HOSTS_FILE" 2>/dev/null || return 0
  begin_count=$(grep -Fc "$STOCK_HOSTS_BEGIN" "$STOCK_HOSTS_FILE" 2>/dev/null || true)
  end_count=$(grep -Fc "$STOCK_HOSTS_END" "$STOCK_HOSTS_FILE" 2>/dev/null || true)
  begin_line=$(grep -Fn "$STOCK_HOSTS_BEGIN" "$STOCK_HOSTS_FILE" 2>/dev/null | head -n 1 | cut -d: -f1 || true)
  end_line=$(grep -Fn "$STOCK_HOSTS_END" "$STOCK_HOSTS_FILE" 2>/dev/null | head -n 1 | cut -d: -f1 || true)
  if [ "$begin_count" != 1 ] || [ "$end_count" != 1 ] || [ "$begin_line" -ge "$end_line" ]; then
    echo "WARNING: malformed sleepypod hosts markers in /etc/hosts; left unchanged" >&2
    return 0
  fi
  cp "$STOCK_HOSTS_FILE" "$STOCK_HOSTS_FILE.bak.sleepypod" || return 0
  tmp=$(mktemp) || return 0
  if awk -v begin="$STOCK_HOSTS_BEGIN" -v end="$STOCK_HOSTS_END" '
    index($0, begin) { skip = 1; next }
    skip { if (index($0, end)) skip = 0; next }
    /^$/ { blank = blank "\n"; next }
    { printf "%s", blank; blank = ""; print }
  ' "$STOCK_HOSTS_FILE" > "$tmp"; then
    # cat keeps the file's inode, owner and mode.
    cat "$tmp" > "$STOCK_HOSTS_FILE" && echo "Removed the old Eight Sleep 0.0.0.0 block from /etc/hosts."
  fi
  rm -f "$tmp"
}

stock_unit_masked() {
  local d
  for d in /etc/systemd/system /run/systemd/system; do
    [ "$(readlink "$STOCK_ROOT$d/$1" 2>/dev/null || true)" = /dev/null ] && return 0
  done
  return 1
}

stock_unit_exists() {
  local d
  for d in /etc/systemd/system /run/systemd/system /lib/systemd/system /usr/lib/systemd/system; do
    { [ -e "$STOCK_ROOT$d/$1" ] || [ -L "$STOCK_ROOT$d/$1" ]; } && return 0
  done
  return 1
}

# Same semantics as mask_stock_units in scripts/lib/telemetry-helpers, but
# unit state comes from the unit directories, and the masked units' run state
# from one systemctl call, so a pod with nothing to do pays at most one.
mask_stock_units_fast() {
  local unit state i=0 states
  local masked=() pending=()
  for unit in "$@"; do
    if stock_unit_masked "$unit"; then
      masked+=("$unit")
    elif stock_unit_exists "$unit"; then
      pending+=("$unit")
    fi
  done
  for unit in ${pending[@]+"${pending[@]}"}; do
    echo "Disabling and masking stock service $unit..."
    systemctl disable --now --no-block "$unit" >/dev/null 2>&1 || true
    systemctl mask "$unit" >/dev/null 2>&1 || echo "WARNING: could not mask $unit" >&2
  done
  [ "${#masked[@]}" -gt 0 ] || return 0
  # is-active prints one state per unit, in order.
  states=$(systemctl is-active "${masked[@]}" 2>/dev/null || true)
  while IFS= read -r state; do
    unit="${masked[$i]:-}"
    i=$((i + 1))
    case "$state" in
      active|activating|reloading)
        [ -n "$unit" ] && { systemctl stop --no-block "$unit" >/dev/null 2>&1 || true; }
        ;;
    esac
  done <<< "$states"
  return 0
}

guard_stock_firmware() {
  remove_stock_hosts_block || true
  if [ -f "$FIRMWARE_UPDATES_CHOICE" ] && [ "$(head -c 16 "$FIRMWARE_UPDATES_CHOICE" 2>/dev/null | head -n 1)" = allow ]; then
    mask_stock_units_fast "${STOCK_TELEMETRY_UNITS[@]}" "${STOCK_APP_UNITS[@]}" "${STOCK_KERNEL_UNITS[@]}"
  else
    mask_stock_units_fast "${STOCK_TELEMETRY_UNITS[@]}" "${STOCK_APP_UNITS[@]}" "${STOCK_FIRMWARE_UPDATE_UNITS[@]}" "${STOCK_KERNEL_UNITS[@]}"
  fi
}
( guard_stock_firmware ) || echo "WARNING: stock firmware guard failed (continuing)" >&2

# 5. Self-heal /persistent/deviceinfo perms so next-server can unlink
# stale dac.sock on startup. Older installs created the dir with mkdir's
# default umask (root:root 0755), which denies write to the sleepypod user
# (even with SupplementaryGroups=dac) — getStatus then fails with
# "EACCES: permission denied, unlink '/persistent/deviceinfo/dac.sock'".
# Newer installs set this correctly; this block reconciles existing pods.
DEVICEINFO_DIR=/persistent/deviceinfo
if getent group dac &>/dev/null; then
  mkdir -p "$DEVICEINFO_DIR"
  OWNER_GROUP=$(stat -c '%U:%G' "$DEVICEINFO_DIR" 2>/dev/null || echo "")
  MODE=$(stat -c '%a' "$DEVICEINFO_DIR" 2>/dev/null || echo "")
  if [ "$OWNER_GROUP" != "root:dac" ] || [ "$MODE" != "2770" ]; then
    if [ -z "$OWNER_GROUP" ] || [ -z "$MODE" ]; then
      echo "Repairing $DEVICEINFO_DIR perms (stat failed → forcing root:dac 2770)..."
    else
      echo "Repairing $DEVICEINFO_DIR perms ($OWNER_GROUP $MODE → root:dac 2770)..."
    fi
    chown root:dac "$DEVICEINFO_DIR" || { echo "ERROR: chown $DEVICEINFO_DIR failed — next-server will fail to unlink dac.sock" >&2; exit 1; }
    chmod 2770 "$DEVICEINFO_DIR"
  fi
fi

# 6. Self-heal the reboot sudoers rule for pods that updated via sp-update
# (which does NOT re-run scripts/install). Newer fresh installs write this
# into /etc/sudoers.d/sleepypod-update; existing pods that only ever run
# sp-update never get it, so the daily / pre-prime reboot jobs
# (JobManager.executeReboot → `sudo -n systemctl reboot`) fail auth and the
# pod never reboots on schedule. Keep the command paths in sync with the
# sleepypod-update fragment in scripts/install. Best-effort: an ExecStartPre
# failure would block the app from starting, so every step tolerates failure.
REBOOT_SUDOERS=/etc/sudoers.d/sleepypod-reboot
REBOOT_SUDOERS_CONTENT='sleepypod ALL=(root) NOPASSWD: /bin/systemctl reboot, /usr/bin/systemctl reboot'
if [ ! -f "$REBOOT_SUDOERS" ] || [ "$(cat "$REBOOT_SUDOERS" 2>/dev/null)" != "$REBOOT_SUDOERS_CONTENT" ]; then
  # sleepypod.service deliberately restricts PATH to /usr/local/bin:/usr/bin:/bin,
  # while sudo installs visudo in /usr/sbin on the pod. Resolve it from the
  # installer's privileged secure_path explicitly so OTA self-healing does not
  # silently skip validation under ExecStartPre.
  VISUDO_BIN=""
  TMP_SUDOERS=""
  for candidate in \
    /usr/local/sbin/visudo /usr/local/bin/visudo \
    /usr/sbin/visudo /usr/bin/visudo /sbin/visudo /bin/visudo; do
    if [ -x "$candidate" ]; then
      VISUDO_BIN="$candidate"
      break
    fi
  done

  if [ -z "$VISUDO_BIN" ]; then
    echo "WARNING: visudo not found — skipping $REBOOT_SUDOERS" >&2
  else
    TMP_SUDOERS=$(mktemp 2>/dev/null || echo "")
  fi
  if [ -n "${TMP_SUDOERS:-}" ]; then
    if ! printf '%s\n' "$REBOOT_SUDOERS_CONTENT" > "$TMP_SUDOERS"; then
      echo "WARNING: could not write temporary reboot sudoers fragment — skipping" >&2
    elif ! chmod 0440 "$TMP_SUDOERS" 2>/dev/null; then
      echo "WARNING: could not secure temporary reboot sudoers fragment — skipping" >&2
    elif "$VISUDO_BIN" -c -q -f "$TMP_SUDOERS" 2>/dev/null; then
      if install -m 0440 -o root -g root "$TMP_SUDOERS" "$REBOOT_SUDOERS" 2>/dev/null; then
        echo "Installed reboot sudoers rule ($REBOOT_SUDOERS)."
      else
        echo "WARNING: could not install $REBOOT_SUDOERS (need root?) — skipping" >&2
      fi
    else
      echo "WARNING: reboot sudoers fragment failed visudo — skipping" >&2
    fi
    rm -f "$TMP_SUDOERS" 2>/dev/null || true
  fi
fi

DISK_AVAIL=$(df -m "$INSTALL_DIR" | awk 'NR==2{print $4}')
echo "Maintenance complete. ${DISK_AVAIL}MB free."
